#!/usr/bin/env python3
"""Fake pw-record: 22050 Hz Stereo s16 auf stdout – Bass-Schlag alle 0,5 s plus Ton, in Echtzeit.
Mit $S/pw-record.still wird Stille geliefert, mit $S/pw-record.speech „Sprache“ (Silben aus Rauschen mit
Wort- und Satzpausen). Aufrufe landen in $S/pw-record.log."""
import math, os, random, struct, sys, time
S = os.path.join(os.environ.get("G19S_TEST_ROOT", "/tmp/g19s-test"), "state")
os.makedirs(S, exist_ok=True)
with open(os.path.join(S, "pw-record.log"), "a") as f:
    f.write(" ".join(sys.argv[1:]) + "\n")
rate, block, n = 22050, 1024, 0
rnd = random.Random(3)
syl_end, gap_end = 0, 0                    # Sprache: Ende der Silbe bzw. der Pause (in Samples)


def speech(i):
    global syl_end, gap_end
    if i >= gap_end:                       # neue Silbe, danach Wort- oder Satzpause
        syl_end = i + int(rnd.uniform(0.12, 0.26) * rate)
        gap_end = syl_end + int((rnd.uniform(0.25, 0.6) if rnd.random() < 0.18 else rnd.uniform(0.02, 0.09)) * rate)
    if i >= syl_end:
        return 0.0
    k = 1 - (syl_end - i) / (0.2 * rate)
    return rnd.gauss(0, 0.3) * math.sin(math.pi * max(0.0, min(1.0, k)))
start = time.monotonic()
out = sys.stdout.buffer
while True:
    still = os.path.exists(os.path.join(S, "pw-record.still"))
    talk = os.path.exists(os.path.join(S, "pw-record.speech"))
    buf = bytearray()
    for i in range(n, n + block):
        t = i / rate
        ph = t % 0.5
        v = 0.0 if still else speech(i) if talk else (0.8 * math.exp(-ph * 14) * math.sin(2 * math.pi * 55 * t) + 0.12 * math.sin(2 * math.pi * 880 * t)
                                                              + 0.2 * math.sin(2 * math.pi * 82 * t))   # Bass klingt durch wie bei echter Musik
        s = int(max(-1, min(1, v)) * 32000)
        buf += struct.pack("<hh", s, int(s * 0.8))
    n += block
    try:
        out.write(buf); out.flush()
    except BrokenPipeError:
        break
    time.sleep(max(0.0, start + n / rate - time.monotonic()))
