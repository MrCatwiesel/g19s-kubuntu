#!/usr/bin/env python3
"""Nachbau von smbclient für die Tests: //host/freigabe → $G19S_TEST_ROOT/smb/host/freigabe."""
import os, shlex, sys, time
args = sys.argv[1:]
svc, cmds, user = args[0], "", None
if "-c" in args: cmds = args[args.index("-c") + 1]
if "-U" in args: user = args[args.index("-U") + 1]
host, share = svc.strip("/").split("/")[:2]
if host == "offline":
    print("do_connect: Connection to offline failed (Error NT_STATUS_HOST_UNREACHABLE)"); sys.exit(1)
if (user, os.environ.get("PASSWD")) != ("nas", "geh%eim"):
    print("session setup failed: NT_STATUS_LOGON_FAILURE"); sys.exit(1)
root = os.path.join(os.environ.get("G19S_TEST_ROOT", "/tmp/g19s-test"), "smb", host, share)
if not os.path.isdir(root):
    print(f"tree connect failed: NT_STATUS_BAD_NETWORK_NAME"); sys.exit(1)
cwd = root
for c in [c.strip() for c in cmds.split(";") if c.strip()]:
    w = shlex.split(c)
    if w[0] == "cd":
        d = os.path.join(root, w[1])
        if not os.path.isdir(d):
            print(f"cd {w[1]}: NT_STATUS_OBJECT_NAME_NOT_FOUND"); sys.exit(1)
        cwd = d
    elif w[0] == "put":
        open(os.path.join(cwd, w[2]), "wb").write(open(w[1], "rb").read())
        print(f"putting file {w[1]} as \\{w[2]} (1,2 kb/s)")
    elif w[0] == "ls":
        for n in [".", ".."] + sorted(os.listdir(cwd)):
            p = os.path.join(cwd, n)
            print(f"  {n:<40} {'D' if os.path.isdir(p) else 'A':>6} {0 if os.path.isdir(p) else os.path.getsize(p):>8}  Tue Sep 29 11:00:00 2026")
        print("\n\t\t123456 blocks of size 4096. 1000 blocks available")
    elif w[0] == "del":
        os.remove(os.path.join(cwd, w[1]))
